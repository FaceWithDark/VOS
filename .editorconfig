# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[{compose.yaml,compose.*.yaml,config/**/*.yaml,proxy/**/*.yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = true
indent_size = unset
indent_style = unset
