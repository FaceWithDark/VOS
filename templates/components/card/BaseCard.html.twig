<div
	class="
		flex
		flex-col
		bg-(--surface)
		border-solid
		rounded-3xl
		border-2
		border-(--border)
	"
	{#
	 # NOTE:
	 # don't ask me why I do it like this. Tailwind v4 is soo new (at the time I
	 # created this) that Symfony TailwindBundle seems to break a lot. I cannot
	 # use any of the `bg-` ultilies at all except the one that add background
	 # colour. Maybe in the future when it's more stable, I'll try to refactor it.
	 #}
	style="
		background-image: none;
		background-repeat: no-repeat;
		background-size: cover;
		background-position: center;
		background-attachment: local;
	"
>
	{% block content %}{% endblock %}
</div>
