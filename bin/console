#!/usr/bin/env php
<?php

declare(strict_types=1);

// @mago-format-ignore-start


/// --- Main namespaces --- ///
use Symfony\Bundle\FrameworkBundle\Console\Application;


/// --- Type hint namespaces --- ///


/// --- Internal namespaces --- ///
use App\Kernel;


// @mago-format-ignore-end
$currentDir  = dirname(__DIR__);
$vendorDir   = "{$currentDir}/vendor";
$runtimeFile = "{$vendorDir}/autoload_runtime.php";


if (!is_dir(filename: $vendorDir)) {
	throw new LogicException(message: 'Dependencies are missing. Try running "composer install".');
}

if (!is_file(filename: $runtimeFile)) {
	throw new LogicException(message: 'Symfony Runtime is missing. Try running "composer require symfony/runtime".');
}

require_once $runtimeFile;

return function (array $context) {
	$kernel = new Kernel(
		environment: $context['APP_ENV'],
		debug: (bool) $context['APP_DEBUG']
	);

	return new Application(kernel: $kernel);
};
